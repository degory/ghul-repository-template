namespace Template.Tests is
    use TestClass = Microsoft.VisualStudio.TestTools.UnitTesting.TestClassAttribute;
    use Test = Microsoft.VisualStudio.TestTools.UnitTesting.TestMethodAttribute;

    entry();

    @TestClass()
    class HELLO_WORLD_GREETER_Tests is
        init() is
        si

        @Test()
        Given_a_TextWriter__Greeter_greet__should_write_Hello_world_to_that_writer() is
            let string_writer = IO.StringWriter();

            let test_object = HELLO_WORLD_GREETER(string_writer);

            test_object.greet();

            assert 
                string_writer
                    .to_string()
                    .trim()
                =~ "Hello world!";
        si
    si
si
